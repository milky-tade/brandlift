# =========================================================
# NOIR STUDIO ENVIRONMENT CONFIGURATION (EXAMPLE)
# Copy this file to .env or set variables in your hosting provider
# (Cloudflare Pages, Netlify, Vercel)
# =========================================================

# Optional: Formspree or custom backend webhook endpoint for inquiry delivery
VITE_FORMSPREE_ENDPOINT=https://formspree.io/f/your_form_id_here

# Optional: Privacy-friendly analytics (e.g. Plausible or Google Analytics 4)
# Leave blank to run with zero third-party tracking scripts
VITE_ANALYTICS_ID=

# Studio Base URL
VITE_SITE_URL=https://noirstudio.agency
